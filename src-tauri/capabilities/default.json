{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "notification:default",
    "shell:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "core:window:allow-create",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-open",
      "allow": [{ "args": ["http://*", "https://*", "mailto:*"] }]
    }
  ]
}
